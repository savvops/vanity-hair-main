---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact the Salon | Vanity Hair Wpg">
  <main id="main-content" class="min-h-screen flex items-center justify-center bg-rich-black">
    <div class="text-center px-4">
      <div class="mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-24 h-24 text-gold mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-white mb-4">
        Confirm your visit with us
      </h1>
      <p class="text-gray-400 text-lg mb-8 max-w-md mx-auto">
        Please call the salon to arrange your appointment. Visiting this page does not confirm a booking.
      </p>
      <a
        href="/#book"
        class="inline-block px-8 py-4 bg-gold text-rich-black font-bold uppercase tracking-wider hover:bg-white transition-colors"
      >
        Contact the Salon
      </a>
    </div>
  </main>
</Layout>
