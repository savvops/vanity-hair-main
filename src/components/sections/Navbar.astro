---
import { getEntry } from 'astro:content';
const navData = await getEntry('navigation', 'main');
const { brandName, navLinks, ctaButton } = navData?.data || {
  brandName: 'Vanity Hair Wpg',
  navLinks: [],
  ctaButton: 'Book Now'
};
---

<nav class="fixed w-full z-50 bg-rich-black/95 border-b border-gold/30 backdrop-blur-sm transition-all duration-300" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#home" class="flex-shrink-0 flex items-center space-x-2 group">
        <i data-lucide="scissors" class="w-6 h-6 text-gold group-hover:rotate-12 transition-transform"></i>
        <span class="font-serif text-base md:text-lg font-bold tracking-wider text-white">
          {brandName}
        </span>
      </a>

      <!-- Desktop Menu -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-8">
          {navLinks
            ?.filter((link: any) => link.enabled !== false)
            ?.sort((a: any, b: any) => (a.order || 0) - (b.order || 0))
            ?.map((link: any) => (
            <a 
              href={link.href} 
              class="text-gray-300 hover:text-gold transition-colors duration-300 text-sm uppercase tracking-widest"
            >
              {link.label}
            </a>
          ))}
          <a 
            href="#book" 
            class="bg-gold hover:bg-gold-light text-rich-black px-5 py-2 rounded-sm font-bold uppercase tracking-wider transition-all transform hover:scale-105"
          >
            {ctaButton}
          </a>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 text-gold hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open navigation menu"
        >
          <svg id="menu-open-icon" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-close-icon" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="hidden md:hidden bg-charcoal border-b border-gold/20">
    <div class="px-4 pt-2 pb-4 space-y-1 text-center">
      {navLinks
        ?.filter((link: any) => link.enabled !== false)
        ?.sort((a: any, b: any) => (a.order || 0) - (b.order || 0))
        ?.map((link: any) => (
        <a 
          href={link.href} 
          class="block px-3 py-3 text-base font-medium text-gray-300 hover:text-gold transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a 
        href="#book" 
        class="block px-3 py-3 bg-gold text-rich-black font-bold mt-4 uppercase tracking-wider"
      >
        {ctaButton}
      </a>
    </div>
  </div>
</nav>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.getElementById('menu-open-icon');
  const menuCloseIcon = document.getElementById('menu-close-icon');

  const setMenuOpen = (isOpen: boolean) => {
    mobileMenu?.classList.toggle('hidden', !isOpen);
    menuOpenIcon?.classList.toggle('hidden', isOpen);
    menuCloseIcon?.classList.toggle('hidden', !isOpen);
    mobileMenuBtn?.setAttribute('aria-expanded', String(isOpen));
    mobileMenuBtn?.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
  };

  mobileMenuBtn?.addEventListener('click', () => {
    setMenuOpen(mobileMenuBtn.getAttribute('aria-expanded') !== 'true');
  });

  // Close mobile menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      setMenuOpen(false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      mobileMenuBtn.focus();
    }
  });

  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('shadow-lg', 'shadow-gold/5');
    } else {
      navbar?.classList.remove('shadow-lg', 'shadow-gold/5');
    }
  });
</script>
