---
import { getEntry } from 'astro:content';
const infoData = await getEntry('infoBanner', 'items');
const items = infoData?.data?.items || [];
---

<section id="info" class="relative z-20 border-y border-white/10 bg-charcoal py-5 scroll-mt-24" aria-label="Visit information">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-1 px-4 sm:px-6 md:grid-cols-3 md:gap-0 lg:px-8">
    {items.map((item: any) => (
      <div class="group flex items-center gap-4 border-b border-white/10 px-4 py-4 last:border-0 md:justify-center md:border-b-0 md:border-r md:last:border-r-0">
        <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full border border-gold/30 bg-rich-black/40 text-gold transition-colors group-hover:border-gold">
          <i data-lucide={item.icon} class="h-5 w-5"></i>
        </span>
        <div>
          <h3 class="mb-1 font-sans text-xs font-bold uppercase tracking-[0.18em] text-white">{item.title}</h3>
          <p class="text-sm text-stone-400">{item.content}</p>
        </div>
      </div>
    ))}
  </div>
</section>
