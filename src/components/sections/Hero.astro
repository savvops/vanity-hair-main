---
import { getEntry } from 'astro:content';
const heroData = await getEntry('hero', 'hero');
const { badge, headlineLine1, headlineAccent, subheadline, ctaPrimary, ctaSecondary, backgroundImage } = heroData?.data || {
  badge: '💈 Est. 2016 💈',
  headlineLine1: 'Sharp Cuts.',
  headlineAccent: 'Timeless Style.',
  subheadline: 'Vanity Hair Wpg - Winnipeg\'s premier destination for precision fades, classic cuts, and hot towel shaves.',
  ctaPrimary: 'Book Appointment',
  ctaSecondary: 'View Services',
  backgroundImage: '/images/vanity hair exterior.webp'
};
---

<section id="home" class="relative flex min-h-[94svh] items-center overflow-hidden pt-[5.5rem]">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img 
      src={backgroundImage} 
      alt="Vanity Hair & Esthetics Exterior"
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-rich-black/35"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-rich-black via-rich-black/75 to-rich-black/10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-rich-black via-transparent to-rich-black/40"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-3xl text-left">
      <div class="mb-6 animate-fade-in">
        <p class="inline-flex items-center gap-3 text-xs font-bold uppercase tracking-[0.3em] text-gold md:text-sm">
          <span class="h-px w-10 bg-gold"></span>{badge}
        </p>
      </div>

      <h1 class="mb-7 font-serif text-5xl font-semibold leading-[0.92] text-white drop-shadow-2xl sm:text-6xl md:text-7xl lg:text-[6.5rem] animate-slide-up">
        {headlineLine1}<br />
        <span class="font-normal italic text-gold">{headlineAccent}</span>
      </h1>

      <p class="mb-10 max-w-2xl text-base font-light leading-relaxed text-stone-200 drop-shadow-lg sm:text-lg md:text-xl animate-fade-in">
        {subheadline}
      </p>

      <div class="flex flex-col gap-3 sm:flex-row animate-slide-up">
        <a
          href="#book"
          class="inline-flex min-h-14 items-center justify-center rounded-full bg-gold px-8 py-4 text-sm font-bold uppercase tracking-[0.14em] text-rich-black shadow-[0_12px_36px_rgba(0,0,0,0.3)] transition-all hover:-translate-y-0.5 hover:bg-gold-light"
        >
          {ctaPrimary}
        </a>
        <a
          href="#services"
          class="inline-flex min-h-14 items-center justify-center rounded-full border border-white/35 bg-rich-black/25 px-8 py-4 text-sm font-bold uppercase tracking-[0.14em] text-white backdrop-blur-md transition-all hover:border-gold hover:text-gold"
        >
          {ctaSecondary}
        </a>
      </div>

      <p class="mt-9 flex items-center gap-2 text-sm text-stone-300">
        <i data-lucide="map-pin" class="h-4 w-4 text-gold"></i>
        432 Graham Avenue <span class="text-gold/60">•</span> Walk-ins welcome
      </p>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 right-6 z-10 hidden animate-bounce sm:block lg:right-10">
    <a href="#info" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-gold backdrop-blur-md transition-colors hover:border-gold hover:text-white" aria-label="Scroll to shop information">
      <i data-lucide="chevron-down" class="w-5 h-5"></i>
    </a>
  </div>
</section>
