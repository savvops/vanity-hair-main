---
import { getEntry } from 'astro:content';
import BrandLogo from '../ui/BrandLogo.astro';
const navData = await getEntry('navigation', 'main');
const { brandName, navLinks, ctaButton } = navData?.data || {
  brandName: 'Vanity Hair Wpg',
  navLinks: [],
  ctaButton: 'Book Now'
};
---

<nav class="fixed w-full z-50 border-b border-white/10 bg-rich-black/80 backdrop-blur-xl transition-all duration-300" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-[5.5rem] items-center justify-between">
      <!-- Logo -->
      <a href="#home" class="group flex flex-shrink-0 items-center" aria-label={`${brandName} home`}>
        <BrandLogo brandName={brandName} />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-center space-x-7">
          {navLinks
            ?.filter((link: any) => link.enabled !== false)
            ?.sort((a: any, b: any) => (a.order || 0) - (b.order || 0))
            ?.map((link: any) => (
            <a 
              href={link.href} 
              class="relative py-2 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-stone-300 transition-colors duration-300 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-gold after:transition-transform hover:text-white hover:after:scale-x-100"
            >
              {link.label}
            </a>
          ))}
          <a 
            href="#book" 
            class="rounded-full bg-gold px-5 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-rich-black transition-all hover:bg-gold-light hover:shadow-[0_0_28px_rgba(208,173,104,0.2)]"
          >
            {ctaButton}
          </a>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 text-gold hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open navigation menu"
        >
          <svg id="menu-open-icon" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-close-icon" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="hidden border-b border-gold/20 bg-rich-black/95 backdrop-blur-xl md:hidden">
    <div class="space-y-1 px-4 pb-6 pt-2 text-center">
      {navLinks
        ?.filter((link: any) => link.enabled !== false)
        ?.sort((a: any, b: any) => (a.order || 0) - (b.order || 0))
        ?.map((link: any) => (
        <a 
          href={link.href} 
          class="block px-3 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-stone-300 transition-colors hover:text-gold"
        >
          {link.label}
        </a>
      ))}
      <a 
        href="#book" 
        class="mt-4 block rounded-full bg-gold px-3 py-3 font-bold uppercase tracking-wider text-rich-black"
      >
        {ctaButton}
      </a>
    </div>
  </div>
</nav>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.getElementById('menu-open-icon');
  const menuCloseIcon = document.getElementById('menu-close-icon');

  const setMenuOpen = (isOpen: boolean) => {
    mobileMenu?.classList.toggle('hidden', !isOpen);
    menuOpenIcon?.classList.toggle('hidden', isOpen);
    menuCloseIcon?.classList.toggle('hidden', !isOpen);
    mobileMenuBtn?.setAttribute('aria-expanded', String(isOpen));
    mobileMenuBtn?.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
  };

  mobileMenuBtn?.addEventListener('click', () => {
    setMenuOpen(mobileMenuBtn.getAttribute('aria-expanded') !== 'true');
  });

  // Close mobile menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      setMenuOpen(false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      mobileMenuBtn.focus();
    }
  });

  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('shadow-lg', 'shadow-gold/5');
    } else {
      navbar?.classList.remove('shadow-lg', 'shadow-gold/5');
    }
  });
</script>
