---
import { getCollection, getEntry } from 'astro:content';
const settings = await getEntry('servicesSettings', 'settings');
const services = await getCollection('services');
const sortedServices = services?.sort((a: any, b: any) => (a.data.order || 0) - (b.data.order || 0)) || [];
const { heading, icon, note, ctaButton } = settings?.data || {
  heading: 'Service Menu',
  icon: 'scissors',
  note: '* Complimentary beverage with every service.',
  ctaButton: 'Book an Appointment'
};
---

<section id="services" class="relative border-y border-white/5 bg-charcoal py-20 md:py-28">
  <div class="absolute top-0 h-px w-full bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center">
      <span class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full border border-gold/30 text-gold">
        <i data-lucide={icon} class="h-5 w-5"></i>
      </span>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-gold">Cut with intention</p>
      <h2 class="font-serif text-4xl font-semibold text-white md:text-5xl">{heading}</h2>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {sortedServices.map((service: any) => (
        <article class="group relative overflow-hidden border border-white/[0.08] bg-rich-black/70 p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-gold/50 hover:bg-rich-black md:p-7">
          <div class="absolute inset-y-0 left-0 w-0.5 origin-bottom scale-y-0 bg-gold transition-transform duration-300 group-hover:scale-y-100"></div>
          <div class="relative z-10 mb-3 flex items-baseline justify-between gap-5">
            <h3 class="text-lg font-semibold text-white transition-colors group-hover:text-gold md:text-xl">{service.data.title}</h3>
            <span class="whitespace-nowrap font-serif text-xl text-gold md:text-2xl">{service.data.price}</span>
          </div>
          <p class="text-sm leading-relaxed text-stone-500">{service.data.description}</p>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="mb-6 text-sm italic text-stone-500">{note}</p>
      <a 
        href="#book" 
        class="inline-flex min-h-12 items-center justify-center rounded-full border border-gold px-8 py-3 text-xs font-bold uppercase tracking-[0.16em] text-gold transition-all duration-300 hover:bg-gold hover:text-rich-black"
      >
        {ctaButton}
      </a>
    </div>
  </div>
</section>
