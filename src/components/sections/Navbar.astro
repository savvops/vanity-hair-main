---
import BrandLogo from '../ui/BrandLogo.astro';
import { getEntry } from 'astro:content';
const navData = await getEntry('navigation', 'main');
const { brandName, navLinks, ctaButton } = navData?.data || {
  brandName: 'Vanity Hair Wpg',
  navLinks: [],
  ctaButton: 'Book Now'
};
---

<nav class="fixed top-0 w-full z-50 bg-rich-black/95 border-b border-gold/30 backdrop-blur-sm" id="navbar" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#home" class="flex-shrink-0 flex items-center space-x-2 group">
        <BrandLogo />
        <span class="font-serif text-xl md:text-2xl font-semibold tracking-wide text-white">
          {brandName}
        </span>
      </a>

      <!-- Desktop Menu -->
      <div class="hidden lg:block">
        <div class="ml-10 flex items-baseline space-x-8">
          {navLinks
            ?.filter((link: any) => link.enabled !== false)
            ?.sort((a: any, b: any) => (a.order || 0) - (b.order || 0))
            ?.map((link: any) => (
            <a
              href={link.href}
              class="text-gray-300 hover:text-gold transition-colors duration-300 text-sm uppercase tracking-widest"
            >
              {link.label}
            </a>
          ))}
          <a
            href="#book"
            class="bg-gold hover:bg-gold-light text-rich-black px-5 py-2 rounded-sm font-bold uppercase tracking-wider transition-all transform hover:scale-105"
          >
            {ctaButton}
          </a>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="lg:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 text-gold hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open navigation menu"
        >
          <svg id="menu-open-icon" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-close-icon" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="hidden lg:hidden bg-charcoal border-b border-gold/20">
    <div class="px-4 pt-2 pb-4 space-y-1 text-center">
      {navLinks
        ?.filter((link: any) => link.enabled !== false)
        ?.sort((a: any, b: any) => (a.order || 0) - (b.order || 0))
        ?.map((link: any) => (
        <a
          href={link.href}
          class="block px-3 py-3 text-base font-medium text-gray-300 hover:text-gold transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="#book"
        class="block px-3 py-3 bg-gold text-rich-black font-bold mt-4 uppercase tracking-wider"
      >
        {ctaButton}
      </a>
    </div>
  </div>
</nav>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.getElementById('menu-open-icon');
  const menuCloseIcon = document.getElementById('menu-close-icon');
  const navbar = document.getElementById('navbar');
  let scrollTimer: ReturnType<typeof setTimeout>;
  const showNavbar = () => {
    clearTimeout(scrollTimer);
    navbar?.removeAttribute('data-scrolling');
  };

  const setMenuOpen = (isOpen: boolean) => {
    showNavbar();
    mobileMenu?.classList.toggle('hidden', !isOpen);
    menuOpenIcon?.classList.toggle('hidden', isOpen);
    menuCloseIcon?.classList.toggle('hidden', !isOpen);
    mobileMenuBtn?.setAttribute('aria-expanded', String(isOpen));
    mobileMenuBtn?.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
  };

  mobileMenuBtn?.addEventListener('click', () => {
    setMenuOpen(mobileMenuBtn.getAttribute('aria-expanded') !== 'true');
  });

  // Close mobile menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      setMenuOpen(false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      mobileMenuBtn.focus();
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setMenuOpen(false));

  // Stay out of the way during scrolling, then return after a short pause.
  // Open menus and keyboard navigation always remain accessible.
  navbar?.addEventListener('focusin', showNavbar);
  window.addEventListener('scroll', () => {
    clearTimeout(scrollTimer);
    navbar?.classList.toggle('shadow-lg', window.scrollY > 50);
    if (window.scrollY <= 80 || mobileMenuBtn?.getAttribute('aria-expanded') === 'true' || navbar?.querySelector(':focus-visible')) {
      showNavbar();
      return;
    }
    navbar?.setAttribute('data-scrolling', '');
    scrollTimer = setTimeout(showNavbar, 220);
  }, { passive: true });
</script>

<style>
  nav { transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1); }
  nav[data-scrolling] { transform: translateY(-110%); }
</style>
