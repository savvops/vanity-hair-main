---
import { getEntry } from 'astro:content';
const bookingData = await getEntry('booking', 'settings');
const contactInfo = await getEntry('contactInfo', 'info');

const booking = bookingData?.data || {
  formTitle: 'Book Your Visit',
  formSubtitle: 'Contact us directly to schedule an appointment.'
};

const contact = contactInfo?.data;
---

<section id="book" class="py-24 bg-rich-black relative overflow-hidden">
  <!-- Subtle Background Decorations -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-gold/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-gold/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-white mb-6 animate-fade-in">
        {booking.formTitle}
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        {booking.formSubtitle}
      </p>
    </div>

    <!-- Main Contact Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      
      <!-- Primary Booking Actions -->
      <div class="bg-charcoal/50 p-8 md:p-10 border-t-4 border-gold backdrop-blur-sm">
        <h3 class="text-gold uppercase tracking-widest text-sm font-bold mb-8">{contact?.contactTitle || 'Contact'}</h3>
        
        <div class="space-y-8">
          <!-- Mobile Support -->
          <div class="group">
            <p class="text-gray-400 text-xs uppercase tracking-widest mb-2 font-medium">Direct Booking (Mobile)</p>
            <a 
              href={contact?.phoneHref}
              class="text-3xl md:text-4xl font-serif text-white hover:text-gold transition-colors duration-300 block mb-4"
            >
              {contact?.phone}
            </a>
            <a 
              href={contact?.phoneHref}
              class="inline-flex items-center space-x-2 bg-gold text-rich-black px-6 py-3 font-bold uppercase tracking-wider hover:bg-white transition-all transform hover:scale-105"
            >
              <i data-lucide="phone" class="w-4 h-4"></i>
              <span>Call Now</span>
            </a>
          </div>

          <hr class="border-gray-800" />

          <!-- Landline and Email -->
          <div class="grid grid-cols-1 gap-6">
            {contact?.phone2 && (
              <a href={contact.phone2Href} class="flex items-center group">
                <div class="w-10 h-10 border border-gold/30 rounded-full flex items-center justify-center mr-4 group-hover:border-gold transition-colors">
                  <i data-lucide="phone-forwarded" class="w-4 h-4 text-gold"></i>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-tighter">Landline</p>
                  <p class="text-white group-hover:text-gold transition-colors">{contact.phone2}</p>
                </div>
              </a>
            )}
            
            {contact?.email && (
              <a href={`mailto:${contact.email}`} class="flex items-center group">
                <div class="w-10 h-10 border border-gold/30 rounded-full flex items-center justify-center mr-4 group-hover:border-gold transition-colors">
                  <i data-lucide="mail" class="w-4 h-4 text-gold"></i>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-tighter">Email</p>
                  <p class="text-white group-hover:text-gold transition-colors">{contact.email}</p>
                </div>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Location & Hours -->
      <div class="space-y-10 py-4">
        <!-- Address -->
        <div>
          <h3 class="text-gold uppercase tracking-widest text-sm font-bold mb-4">{contact?.findUsTitle || 'Location'}</h3>
          <p class="text-2xl text-white font-serif mb-2">{contact?.businessName}</p>
          <p class="text-gray-400 leading-relaxed">
            {contact?.addressLine1}<br />
            {contact?.addressLine2}
          </p>
          <a 
            href={contact?.directionsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-2 text-gold hover:text-white transition-colors mt-6 border-b border-gold/30 pb-1"
          >
            <i data-lucide="map-pin" class="w-4 h-4"></i>
            <span>{contact?.directionsLabel}</span>
          </a>
        </div>

        <!-- Hours -->
        <div>
          <h3 class="text-gold uppercase tracking-widest text-sm font-bold mb-4">{contact?.hoursTitle || 'Hours'}</h3>
          <div class="space-y-2">
            {contact?.hours?.map((item: any) => (
              <div class="flex justify-between items-center max-w-xs text-gray-400 border-b border-white/5 pb-2">
                <span class="text-sm">{item.day}</span> 
                <span class={`text-sm font-medium ${item.highlight ? "text-gold" : "text-white"}`}>
                  {item.hours}
                </span>
              </div>
            ))}
          </div>
          <p class="text-gray-500 text-xs mt-4 italic">{contact?.hoursNote}</p>
        </div>

        <!-- Socials -->
        <div>
          <h3 class="text-gold uppercase tracking-widest text-sm font-bold mb-4">Follow Us</h3>
          <div class="flex space-x-6">
            <a href={contact?.instagramLink} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gold transition-colors transform hover:scale-110">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
            {contact?.facebookLink && (
              <a href={contact.facebookLink} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gold transition-colors transform hover:scale-110">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            )}
            {contact?.tiktokLink && (
              <a href={contact.tiktokLink} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gold transition-colors transform hover:scale-110">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.87a8.16 8.16 0 0 0 4.76 1.52v-3.4a4.85 4.85 0 0 1-1-.3z"/></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
