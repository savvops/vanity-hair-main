---
// Admin/Edit Page - Links to content management
// This page provides easy access to edit the website content

const githubRepo = 'https://github.com/savvops/vanity-hair-main';
const pagesCmsUrl = 'https://app.pagescms.org/savvops/vanity-hair-main';
const contentFolder = `${githubRepo}/tree/main/src/content`;

const sections = [
  {
    title: 'Site Settings',
    description: 'Site name, description, logo, favicon, contact info',
    cmsLink: `${pagesCmsUrl}/collection/siteSettings`,
    githubLink: `${githubRepo}/edit/main/src/content/siteSettings/settings.json`
  },
  {
    title: 'Navigation',
    description: 'Menu items, brand name, CTA button',
    cmsLink: `${pagesCmsUrl}/collection/navigation`,
    githubLink: `${githubRepo}/edit/main/src/content/navigation/main.json`
  },
  {
    title: 'Hero Section',
    description: 'Homepage hero headline, subtitle, background image',
    cmsLink: `${pagesCmsUrl}/collection/hero`,
    githubLink: `${githubRepo}/edit/main/src/content/homepage/hero.json`
  },
  {
    title: 'About Section',
    description: 'About page content, features, image',
    cmsLink: `${pagesCmsUrl}/collection/about`,
    githubLink: `${githubRepo}/edit/main/src/content/homepage/about.json`
  },
  {
    title: 'Services',
    description: 'Service menu items, prices, descriptions',
    cmsLink: `${pagesCmsUrl}/collection/services`,
    githubLink: `${contentFolder}/services`
  },
  {
    title: 'Testimonials',
    description: 'Customer reviews and ratings',
    cmsLink: `${pagesCmsUrl}/collection/testimonials`,
    githubLink: `${contentFolder}/testimonials`
  },
  {
    title: 'Gallery',
    description: 'Photo gallery images and Instagram link',
    cmsLink: `${pagesCmsUrl}/collection/gallery`,
    githubLink: `${githubRepo}/edit/main/src/content/gallery/settings.json`
  },
  {
    title: 'Booking Form',
    description: 'Booking form fields and options',
    cmsLink: `${pagesCmsUrl}/collection/booking`,
    githubLink: `${githubRepo}/edit/main/src/content/booking/settings.json`
  },
  {
    title: 'Contact Info',
    description: 'Address, hours, phone, social links',
    cmsLink: `${pagesCmsUrl}/collection/contactInfo`,
    githubLink: `${githubRepo}/edit/main/src/content/contactInfo/info.json`
  },
  {
    title: 'Footer',
    description: 'Footer content and social links',
    cmsLink: `${pagesCmsUrl}/collection/footer`,
    githubLink: `${githubRepo}/edit/main/src/content/footer/settings.json`
  },
  {
    title: 'SEO Settings',
    description: 'Page titles, meta descriptions, keywords',
    cmsLink: `${pagesCmsUrl}/collection/seo`,
    githubLink: `${githubRepo}/edit/main/src/content/seo/settings.json`
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit Website Content | Vanity Hair & Esthetics</title>
    <style is:global>
      :root {
        --gold: #d4af37;
        --gold-light: #e5c158;
        --rich-black: #0a0a0a;
        --charcoal: #141414;
      }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: var(--rich-black);
        color: white;
        margin: 0;
        min-height: 100vh;
      }
      .gold-gradient {
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 50%, var(--gold) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .bg-charcoal { background-color: var(--charcoal); }
      .border-gold-20 { border-color: rgba(212, 175, 55, 0.2); }
      .text-gold { color: var(--gold); }
    </style>
  </head>
  <body class="min-h-screen">
    <!-- Header -->
    <header class="bg-charcoal border-b border-gold-20">
      <div style="max-width: 80rem; margin: 0 auto; padding: 1.5rem 2rem;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div>
            <h1 style="font-size: 1.875rem; font-weight: bold; margin: 0;" class="gold-gradient">Vanity Hair Wpg</h1>
            <p style="color: #9ca3af; margin-top: 0.25rem;">Website Content Management</p>
          </div>
          <a 
            href="/" 
            style="color: var(--gold); text-decoration: none; display: flex; align-items: center; gap: 0.5rem;"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            View Website
          </a>
        </div>
      </div>
    </header>

    <main style="max-width: 80rem; margin: 0 auto; padding: 3rem 2rem;">
      <!-- Quick Actions -->
      <div class="bg-charcoal border-gold-20" style="border-radius: 0.5rem; border: 1px solid rgba(212, 175, 55, 0.2); padding: 2rem; margin-bottom: 3rem;">
        <h2 style="font-size: 1.5rem; font-weight: bold; color: var(--gold); margin-top: 0; margin-bottom: 1.5rem;">Quick Actions</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
          <a 
            href={pagesCmsUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="background-color: var(--gold); color: var(--rich-black); text-decoration: none; font-weight: 600; padding: 1rem; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem; transition: background 0.2s;"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            Open PagesCMS Editor
          </a>
          <a 
            href={contentFolder}
            target="_blank"
            rel="noopener noreferrer"
            style="background-color: #1f2937; color: white; text-decoration: none; font-weight: 600; padding: 1rem; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem; border: 1px solid #4b5563; transition: background 0.2s;"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            Browse Content Files
          </a>
        </div>
      </div>

      <!-- Content Sections -->
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.5rem; font-weight: bold; color: white; margin-bottom: 1rem;">Content Sections</h2>
        <p style="color: #9ca3af; margin-bottom: 2rem;">Click on any section to edit its content. Changes are saved to GitHub and will be live within minutes.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
        {sections.map((section) => (
          <div class="bg-charcoal" style="border-radius: 0.5rem; border: 1px solid #1f2937; padding: 1.5rem; transition: border-color 0.2s;">
            <h3 style="font-size: 1.125rem; font-weight: 600; color: white; margin-top: 0; margin-bottom: 0.5rem;" class="group-hover-text-gold">
              {section.title}
            </h3>
            <p style="color: #9ca3af; font-size: 0.875rem; margin-bottom: 1.5rem;">{section.description}</p>
            <div style="display: flex; gap: 0.5rem;">
              <a 
                href={section.cmsLink}
                target="_blank"
                rel="noopener noreferrer"
                style="flex: 1; background-color: rgba(212, 175, 55, 0.1); color: var(--gold); border: 1px solid var(--gold); text-decoration: none; font-size: 0.875rem; font-weight: 500; padding: 0.5rem 1rem; border-radius: 0.25rem; text-align: center; transition: all 0.2s;"
              >
                Edit in CMS
              </a>
              <a 
                href={section.githubLink}
                target="_blank"
                rel="noopener noreferrer"
                style="background-color: #1f2937; color: #d1d5db; text-decoration: none; font-size: 0.875rem; font-weight: 500; padding: 0.5rem 0.75rem; border-radius: 0.25rem; transition: background 0.2s;"
                title="Edit on GitHub"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Instructions -->
      <div style="margin-top: 3rem; background-color: rgba(31, 41, 55, 0.5); border-radius: 0.5rem; border: 1px solid #1f2937; padding: 2rem;">
        <h3 style="font-size: 1.25rem; font-weight: bold; color: var(--gold); margin-top: 0; margin-bottom: 1.5rem;">How to Edit Content</h3>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div style="display: flex; gap: 1rem;">
            <span style="flex-shrink: 0; width: 2rem; height: 2rem; background-color: var(--gold); color: var(--rich-black); border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-weight: bold;">1</span>
            <div>
              <p style="font-weight: 500; color: white; margin: 0;">Using PagesCMS (Recommended)</p>
              <p style="font-size: 0.875rem; color: #9ca3af; margin-top: 0.25rem;">Open the CMS Editor to edit all site content through a simple visual interface. No code required.</p>
            </div>
          </div>
          <div style="display: flex; gap: 1rem;">
            <span style="flex-shrink: 0; width: 2rem; height: 2rem; background-color: var(--gold); color: var(--rich-black); border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-weight: bold;">2</span>
            <div>
              <p style="font-weight: 500; color: white; margin: 0;">Direct GitHub Editing</p>
              <p style="font-size: 0.875rem; color: #9ca3af; margin-top: 0.25rem;">Click the pencil icon to edit JSON data files directly on GitHub.</p>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer style="border-t: 1px solid #1f2937; margin-top: 4rem; padding: 2rem 0;">
      <div style="max-width: 80rem; margin: 0 auto; padding: 0 2rem;">
        <p style="text-align: center; color: #6b7280; font-size: 0.875rem;">
          Vanity Hair & Esthetics Content Management
        </p>
      </div>
    </footer>
  </body>
</html>
  </body>
</html>
