---
import Icon from '../ui/Icon.astro';
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import { getEntry } from 'astro:content';
const heroData = await getEntry('hero', 'hero');
const { badge, headlineLine1, headlineAccent, subheadline, ctaPrimary, ctaSecondary, backgroundImage } = heroData?.data || {
  badge: '💈 Est. 2016 💈',
  headlineLine1: 'Sharp Cuts.',
  headlineAccent: 'Timeless Style.',
  subheadline: 'Vanity Hair Wpg - Winnipeg\'s premier destination for precision fades, classic cuts, and hot towel shaves.',
  ctaPrimary: 'Book Appointment',
  ctaSecondary: 'View Services',
  backgroundImage: '/images/vanity-hair-exterior.webp'
};
---

<section id="home" class="relative min-h-[max(48rem,100svh)] flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <ResponsiveImage
      src={backgroundImage}
      eager
      alt="Vanity Hair & Esthetics Exterior"
      class="w-full h-full object-cover"
    />
    <!-- Lighter overlay for better image visibility -->
    <div class="absolute inset-0 bg-rich-black/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-rich-black/80 via-rich-black/20 to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto pt-28 pb-32">
    <div class="inline-block mb-4">
      <div class="hero-rule h-px w-16 bg-gold mx-auto mb-6"></div>
      <p class="text-gold uppercase tracking-[0.3em] text-sm md:text-base font-bold mb-2">{badge}</p>
    </div>

    <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif font-medium text-white mb-6 text-shadow leading-tight">
      {headlineLine1}<br />
      <span class="text-gold italic">{headlineAccent}</span>
    </h1>

    <p class="text-gray-100 text-lg md:text-xl max-w-2xl mx-auto mb-10 font-light drop-shadow-lg">
      {subheadline}
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href="#book"
        class="hero-button px-8 py-4 bg-gold text-rich-black font-semibold text-sm uppercase tracking-[0.14em] hover:bg-gold-light rounded-sm"
      >
        {ctaPrimary}
      </a>
      <a
        href="#services"
        class="hero-button px-8 py-4 border border-gold text-gold font-semibold text-sm uppercase tracking-[0.14em] hover:bg-gold hover:text-rich-black rounded-sm backdrop-blur-sm bg-black/20"
      >
        {ctaSecondary}
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-cue absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10">
    <a href="#info" aria-label="View location, hours and contact details" class="text-gold hover:text-white transition-colors drop-shadow-lg">
      <Icon name="chevron-down" class="w-8 h-8" />
    </a>
  </div>
</section>
