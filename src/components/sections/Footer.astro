---
import { getEntry } from 'astro:content';
const footerData = await getEntry('footer', 'settings');
const { brandName, address, copyright, socialLinks, quickLinks } = footerData?.data || {
  brandName: 'Vanity Hair Wpg',
  address: '432 Graham Ave, Winnipeg, MB R3C 0L8',
  copyright: 'All rights reserved.',
  socialLinks: [],
  quickLinks: []
};
const currentYear = new Date().getFullYear();
---

<footer class="bg-black py-12 border-t border-gray-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <!-- Logo -->
      <div class="mb-6 md:mb-0 text-center md:text-left">
        <span class="font-serif text-lg font-bold tracking-wider text-white">
          {brandName}
        </span>
        <p class="text-gray-600 text-sm mt-2">
          {address}<br />
          © {currentYear} {brandName}. {copyright}
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex space-x-6">
        {socialLinks?.map((link: any) => (
          <a 
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-gold transition-colors"
            aria-label={link.label}
          >
            {link.platform === 'facebook' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            )}
            {link.platform === 'instagram' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            )}
            {link.platform === 'tiktok' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.87a8.16 8.16 0 0 0 4.76 1.52v-3.4a4.85 4.85 0 0 1-1-.3z"/></svg>
            )}
            {!['facebook', 'instagram', 'tiktok'].includes(link.platform) && (
              <i data-lucide={link.platform} class="w-6 h-6"></i>
            )}
          </a>
        ))}
      </div>
    </div>
    
    <!-- Quick Links -->
    <div class="mt-8 pt-8 border-t border-gray-900">
      <div class="flex flex-wrap justify-center gap-6 text-sm">
        {quickLinks?.map((link: any) => (
          <a href={link.href} class="text-gray-500 hover:text-gold transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
